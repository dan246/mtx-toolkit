# MTX Toolkit Environment Variables

# Flask
FLASK_ENV=development
# REQUIRED in production/staging — app refuses to start on the dev default.
SECRET_KEY=your-secret-key-here

# Authentication (JWT-style signed bearer tokens)
# JWT_SECRET_KEY defaults to SECRET_KEY if unset.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
AUTH_ENABLED=true
# Initial admin created on first startup if no users exist. CHANGE IMMEDIATELY.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

# CORS — comma-separated allowlist of frontend origins.
# REQUIRED in production/staging (no wildcard). Defaults to the local dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
# JSON logs in prod; set false for human-readable dev output.
LOG_JSON=true

# Database
DATABASE_URL=postgresql://mtx:mtx_password@localhost:15433/mtx_toolkit

# Redis
REDIS_URL=redis://localhost:6380/0

# MediaMTX Connection (連接到你現有的 MediaMTX)
# 如果使用 docker-compose，則使用 host.docker.internal
# 如果本地開發，則使用 localhost
MEDIAMTX_API_URL=http://localhost:9998
MEDIAMTX_RTSP_URL=rtsp://localhost:8555

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Auto-remediation
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# Recording
RECORDING_BASE_PATH=/recordings
DISK_USAGE_THRESHOLD=0.85
